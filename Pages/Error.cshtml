@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="message-page">
    <div class="message-code">Error</div>
    <h1>Something went wrong</h1>
    <p class="muted">The problem has been logged. Please try again, or go back to patient search.</p>
    @if (!string.IsNullOrEmpty(Model.RequestId))
    {
        <p class="small muted">Reference: <code>@Model.RequestId</code></p>
    }
    <a class="btn btn-primary" asp-area="" asp-page="/Index">Back to patient search</a>
</div>