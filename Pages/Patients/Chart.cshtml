@page "{id:int}"
@model ClinicalView.Pages.Patients.ChartModel
@{
    var patient = Model.Header.Patient;
    ViewData["Title"] = Display.PatientName(patient);
    var tabs = new[] { "Active", "Discontinued", "All" };
}

@section Banner {
    <partial name="_PatientBanner" model="Model.Header" />
}

<div class="chart-layout">
    <partial name="_PatientNav" model="Model.Header" />

    <div class="chart-content">

        @* ---------- Demographics ---------- *@
        <section class="panel" id="demographics">
            <div class="panel-head">
                <h2>Demographics</h2>
                <a class="btn btn-primary btn-icon" href="/api/patients/@patient.PatientId/summary-pdf">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V2h12v7" /><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" /><path d="M6 14h12v8H6z" /></svg>
                    Print to PDF
                </a>
            </div>
            <dl class="field-grid">
                <div><dt>Legal name</dt><dd>@patient.FirstName @patient.LastName</dd></div>
                <div><dt>MRN</dt><dd>@patient.MRN</dd></div>
                <div><dt>Date of birth</dt><dd>@Display.Date(patient.DOB) (@patient.Age y)</dd></div>
                <div><dt>Gender</dt><dd>@patient.Gender</dd></div>
                <div><dt>Phone</dt><dd>@Display.OrDash(patient.PhoneNumber)</dd></div>
                <div><dt>Address</dt><dd>@Display.OrDash(patient.AddressLine1)<br />@patient.City, @patient.State @patient.ZipCode</dd></div>
            </dl>
        </section>

        <div class="two-col">
            @* ---------- Allergies ---------- *@
            <section class="panel" id="allergies">
                <div class="panel-head">
                    <h2>Allergies</h2>
                    <span class="muted">@Model.Header.Allergies.Count(a => a.Status == "Active") active</span>
                </div>
                @if (!Model.Header.Allergies.Any())
                {
                    <div class="empty-state empty-good">No Known Allergies</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="data-table">
                            <thead>
                                <tr><th>Allergen</th><th>Severity</th><th>Status</th><th>Recorded</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var allergy in Model.Header.Allergies)
                                {
                                    <tr class="@(allergy.Status == "Active" ? "" : "row-inactive")">
                                        <td class="fw-semibold">@allergy.AllergyName</td>
                                        <td><span class="@Display.SeverityPill(allergy.Severity)">@allergy.Severity</span></td>
                                        <td>@allergy.Status</td>
                                        <td>@Display.Date(allergy.RecordedDate)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>

            @* ---------- Alerts ---------- *@
            <section class="panel" id="alerts">
                <div class="panel-head">
                    <h2>Alerts</h2>
                    <span class="muted">@Model.Header.Alerts.Count active</span>
                </div>
                @if (!Model.Header.Alerts.Any())
                {
                    <div class="empty-state">No active alerts</div>
                }
                else
                {
                    <ul class="alert-list">
                        @foreach (var alert in Model.Header.Alerts)
                        {
                            <li class="alert-item @(alert.Severity == "High" ? "alert-high" : "alert-normal")">
                                <div class="alert-title">@alert.AlertType <span class="@Display.SeverityPill(alert.Severity)">@alert.Severity</span></div>
                                <div class="alert-text">@alert.Description</div>
                                <div class="alert-date">Since @Display.Date(alert.CreatedDate)</div>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>

        @* ---------- Medications ---------- *@
        <section class="panel" id="medications">
            <div class="panel-head">
                <h2>Medications</h2>
                <div class="tabs" role="tablist" aria-label="Medication status">
                    @foreach (var tab in tabs)
                    {
                        <a asp-page="/Patients/Chart" asp-route-id="@patient.PatientId" asp-route-medStatus="@tab"
                           asp-fragment="medications" role="tab" aria-selected="@(Model.MedStatus == tab ? "true" : "false")"
                           class="tab @(Model.MedStatus == tab ? "active" : "")">@tab</a>
                    }
                </div>
            </div>
            @if (!Model.Medications.Any())
            {
                <div class="empty-state">No @(Model.MedStatus == "All" ? "" : Model.MedStatus.ToLower()) medications on file.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Medication</th>
                                <th>Instructions</th>
                                <th>Route</th>
                                <th>Frequency</th>
                                <th>Start</th>
                                <th>End</th>
                                <th>Prescriber</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var med in Model.Medications)
                            {
                                <tr>
                                    <td><strong>@med.MedicationName</strong><div class="muted small">@med.Strength</div></td>
                                    <td>@Display.OrDash(med.DosageInstructions)</td>
                                    <td>@Display.OrDash(med.Route)</td>
                                    <td>@Display.OrDash(med.Frequency)</td>
                                    <td>@Display.Date(med.StartDate)</td>
                                    <td>@Display.Date(med.EndDate)</td>
                                    <td>@Display.OrDash(med.PrescribingProvider)</td>
                                    <td><span class="@Display.StatusPill(med.Status)">@med.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>