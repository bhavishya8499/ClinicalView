@* The right side of the top bar: who is logged in, and the Log out button. *@
@if (User.Identity?.IsAuthenticated == true)
{
    var userName = User.Identity.Name ?? "";
    var initial = userName.Length > 0 ? userName[..1].ToUpperInvariant() : "?";

    <div class="user-menu">
        <span class="avatar" aria-hidden="true">@initial</span>
        <span class="user-name">@userName</span>
        <form method="post" asp-area="Identity" asp-page="/Account/Logout"
              asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
            <button type="submit" class="btn-logout">Log out</button>
        </form>
    </div>
}
else
{
    <div class="user-menu">
        <a class="btn-logout" asp-area="Identity" asp-page="/Account/Login">Log in</a>
    </div>
}