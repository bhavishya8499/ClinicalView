@page
@model IndexModel
@{
    ViewData["Title"] = "Patient Search";
}

<div class="page-head">
    <h1>Patient Search</h1>
    <p class="muted">Search by MRN, date of birth, first name or last name. Partial names work, so "Harr" finds Harrison, Harris and Harrington.</p>
</div>

<section class="panel">
    <form id="searchForm" novalidate>
        <div class="search-grid">
            <div class="field">
                <label for="mrn">MRN</label>
                <input id="mrn" name="mrn" type="text" class="form-control" maxlength="20" placeholder="e.g. 00482917" autocomplete="off" />
            </div>
            <div class="field">
                <label for="dob">Date of birth</label>
                <input id="dob" name="dob" type="date" class="form-control" min="1900-01-01" />
            </div>
            <div class="field">
                <label for="firstName">First name</label>
                <input id="firstName" name="firstName" type="text" class="form-control" maxlength="50" placeholder="First name" autocomplete="off" />
            </div>
            <div class="field">
                <label for="lastName">Last name</label>
                <input id="lastName" name="lastName" type="text" class="form-control" maxlength="50" placeholder="Last name" autocomplete="off" />
            </div>
        </div>

        <div id="searchErrors" class="alert alert-danger mt-3 mb-0 d-none" role="alert"></div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
                Search
            </button>
            <button type="button" id="clearButton" class="btn btn-outline-secondary">Clear</button>
            <span class="muted small">At least one field is required.</span>
        </div>
    </form>
</section>

<section class="panel" aria-live="polite">
    <div class="panel-head">
        <h2>Results</h2>
        <span id="resultsSummary" class="muted">Enter a search above to see patients.</span>
    </div>

    <div id="resultsLoading" class="loading d-none">
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Searching...</span></div>
    </div>

    <div class="table-responsive">
        <table id="resultsTable" class="data-table d-none">
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>MRN</th>
                    <th>DOB / Age</th>
                    <th>Sex</th>
                    <th>Phone</th>
                    <th>City</th>
                    <th><span class="visually-hidden">Open</span></th>
                </tr>
            </thead>
            <tbody id="resultsBody"></tbody>
        </table>
    </div>

    <div id="emptyState" class="empty-state d-none">
        No patients match your search. Check the spelling or try fewer fields.
    </div>
</section>

@section Scripts {
    <script src="~/js/search.js" asp-append-version="true"></script>
}